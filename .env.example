# Copy this file to .env and fill in your values.
# Only used by --answer-questions / "answer_questions": true in parse-html and render-and-parse.
# Values here are only used as defaults -- any --qa-* flag on the command line wins.

ANTHROPIC_API_KEY=sk-ant-xxx

# Short model name -- resolved to the real model ID (see README).
# Options: sonnet5, opus5, fable5.1, haiku4.5, sonnet4.5, sonnet4, opus4.1,
#          opus4, sonnet3.7, sonnet3.5, haiku3.5, opus3, haiku3
# (a full model ID also works here, e.g. claude-sonnet-4-20250514)
ANTHROPIC_MODEL=sonnet5

LLM_PROVIDER=anthropic
